# ============================================================
# Enterprise MCP Server - Environment Configuration
# 复制为 .env 后按需修改
# Copy to .env and adjust
# ============================================================

# 服务名称 / Server name
MCP_SERVER_NAME=enterprise-mcp

# ---- 鉴权 / Authentication ----
# 启用 Token 鉴权 (true/false)
AUTH_ENABLED=true
# 静态 API Token（生产环境务必通过密钥管理注入，勿写死在代码）
API_TOKENS=dev-token-123,dev-token-456

# ---- 限流 / Rate Limiting ----
# 启用限流 (true/false)
RATE_LIMIT_ENABLED=true
# 每分钟最大请求数（按客户端标识维度）
RATE_LIMIT_PER_MINUTE=60

# ---- 数据脱敏 / Desensitization ----
# 启用响应数据脱敏 (true/false)
DESENSITIZE_ENABLED=true
# 需要脱敏的字段名（逗号分隔，支持正则匹配）
DESENSITIZE_FIELDS=phone,id_card,mobile,email,idcard

# ---- 审计日志 / Audit Logging ----
# 启用审计日志 (true/false)
AUDIT_ENABLED=true
# 审计日志输出：console / file
AUDIT_OUTPUT=console
# 审计日志文件路径（AUDIT_OUTPUT=file 时生效）
AUDIT_LOG_FILE=logs/audit.log

# ---- Redis（可选，用于跨实例限流/会话隔离）----
# 启用 Redis 存储 (true/false)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ---- HTTP / 传输 ----
# HTTP 传输监听地址
HOST=0.0.0.0
PORT=8080
